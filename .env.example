APP_DATA_DIR=./data
AGENT_CONFIG_PATH=./config/agents.yaml
APP_MOCK_EXTERNAL_SERVICES=true
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_API_STYLE=chat_completions
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_KNOWLEDGE_API_KEY=
DIFY_DATASET_ID=
DIFY_SEARCH_METHOD=semantic_search
PDF_PLATFORM_MODE=mock
PDF_PLATFORM_BASE_URL=
PDF_PLATFORM_API_KEY=
PDF_PLATFORM_COMMAND=[]
PDF_PLATFORM_URL_TEMPLATE=
OCR_ENABLED=false
OCR_COMMAND=[]
MINERU_ENABLED=false
MINERU_URL=http://127.0.0.1:19100/pdf_parse
MINERU_TIMEOUT_SECONDS=120
MINERU_RETURN_CONTENT_LIST=false
MINERU_RETURN_IMAGES=false
MINERU_FALLBACK_ON_ERROR=true
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_RETRIEVAL_ROUNDS=3
AGENT_MAX_EVIDENCE_FOR_ANSWER=12
AUTH_ENABLED=true
ADMIN_USERNAME=sansuokb
# 使用 app.auth.hash_password("新密码") 生成，不要在这里保存明文密码。
ADMIN_PASSWORD_HASH=
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
# 可选 LDAP：例如 LDAP_SERVER_URL=ldap://ad.example.local:389
LDAP_ENABLED=false
LDAP_SERVER_URL=
LDAP_USER_DN_TEMPLATE=
LDAP_BASE_DN=
LDAP_USER_FILTER=(uid={username})
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_TIMEOUT_SECONDS=5
EXTERNAL_API_ENABLED=false
EXTERNAL_API_KEY=
INGEST_WORKER_COUNT=3
INGEST_UPLOAD_BATCH_SIZE=25
INGEST_MAX_FILES_PER_JOB=2000
INGEST_MAX_RETRIES=3
ASK_CONCURRENCY_LIMIT=40
ASK_QUEUE_TIMEOUT_SECONDS=10
REQUEST_TIMEOUT_SECONDS=600
MINERU_TIMEOUT_SECONDS=600
# 可选：通过 Nginx 子路径对外提供服务时，用于生成可点击的原文件链接。
# 例如：APP_PUBLIC_BASE_URL=http://10.2.108.71:1030/kb/
APP_PUBLIC_BASE_URL=
